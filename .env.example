# Code Akos configuration. The desktop app's setup (or `npm run setup` from source) writes .env for you;
# or copy this file to .env and edit it. Every variable has a default.

PORT=7420
# Where the dashboard listens. Keep the default unless you run in a container (docs/docker.md).
# ORCH_DASHBOARD_HOST=127.0.0.1
# The port you publish the dashboard on, if it is not PORT (Docker: -p 127.0.0.1:8080:7420). Added to the Host check.
# ORCH_DASHBOARD_PUBLIC_PORT=

# Where the token, databases, encryption key and clones live.
# ORCH_DATA_DIR=~/.code-akos

# GitHub tokens are NOT configured here: each project has its own, stored encrypted in
# <data folder>/projects.db. Add projects on the Projects tab.
# ORCH_GITHUB_API_URL=https://api.github.com
# ORCH_GITHUB_CLONE_URL=https://github.com/{repo}.git

# Models. Triage and the resolver each try these in order and fall back down the list when one fails.
# Default order: ollama, deepseek, anthropic. One that is not set up below is skipped.
# A provider named in one of these lists must be set up below, or startup stops with an error.
# ORCH_LLM_PROVIDERS=ollama,deepseek,anthropic
# ORCH_TRIAGE_PROVIDERS=                  # overrides the line above for triage only
# ORCH_RESOLVER_PROVIDERS=                # overrides the line above for the resolver only

# Local Ollama: triages new errors and writes fixes. Triage uses it only when the URL is set.
# ORCH_OLLAMA_URL=http://localhost:11434
# ORCH_OLLAMA_MODEL=qwen2.5-coder:7b

# DeepSeek (hosted; error text and source code are sent to it).
# ORCH_DEEPSEEK_API_KEY=
# ORCH_DEEPSEEK_MODEL=deepseek-flash      # or deepseek-v4-pro

# Anthropic (hosted; error text and source code are sent to it).
# ORCH_ANTHROPIC_API_KEY=
# ORCH_ANTHROPIC_MODEL=claude-haiku-4-5

# ---- Errors -------------------------------------------------------------------------------
# On by default; 0 leaves it out.
# ORCH_ERRORS_ENABLED=1

# The ingest listener: its own socket, deliberately separate from the dashboard's.
# Loopback by default, so only apps on this machine can report. 0.0.0.0 also lets in
# browsers and other hosts, and anyone who can reach the port can file an error.
# ORCH_ERRORS_INGEST_PORT=3000
# ORCH_ERRORS_INGEST_HOST=127.0.0.1
# ORCH_ERRORS_DSN_PUBLIC_KEY=              # when set, ingest requires this sentry_key
# ORCH_ERRORS_PUBLIC_URL=http://code-akos:3000   # how apps reach ingest, when not at localhost:<port>

# ORCH_ERRORS_DB=~/.code-akos/errors.db
# ORCH_ERRORS_GITHUB_LABELS=bug,sentry
# ORCH_ERRORS_MIN_LEVEL=error
# ORCH_ERRORS_COMMENT_THRESHOLDS=100,1000,10000
# ORCH_ERRORS_RETENTION_DAYS=30            # 0 keeps every raw event

# ---- Resolver -----------------------------------------------------------------------------
# On by default; 0 leaves it out.
# ORCH_RESOLVER_ENABLED=1
# ORCH_RESOLVER_DB=~/.code-akos/resolver.db
# ORCH_RESOLVER_POLL_INTERVAL_MS=300000    # minimum 30000
# ORCH_RESOLVER_MAX_CONCURRENT_FIXES=3
# ORCH_RESOLVER_MAX_ATTEMPTS=3              # tries per issue before it stops; "Run" in the dashboard still works
# ORCH_RESOLVER_MAX_TURNS=20                # model turns one fix attempt may take before it fails; raise it if attempts run out of turns
# ORCH_RESOLVER_LOG_DIR=~/.code-akos/logs   # one log file per issue: <owner>-<repo>-issue-<n>.log
# ORCH_RESOLVER_RETRY_SKIPPED_ATTEMPTS=0
