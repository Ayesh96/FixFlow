{
  "name": "code-akos-desktop",
  "private": true,
  "version": "1.1.1",
  "description": "Code Akos desktop: a GUI setup wizard, then the same dashboard in a window.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "dev.codeakos.desktop",
    "productName": "Code Akos",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "dashboard-preload.js",
      "onboarding.html",
      "icon.png",
      "mark.png",
      "fonts/*.woff2"
    ],
    "extraResources": [
      {
        "from": "../bin",
        "to": "app/bin"
      },
      {
        "from": "../scripts",
        "to": "app/scripts"
      },
      {
        "from": "../server",
        "to": "app/server"
      },
      {
        "from": "../web/dist",
        "to": "app/web/dist"
      },
      {
        "from": "../package.json",
        "to": "app/package.json"
      },
      {
        "from": "../node_modules",
        "to": "app/node_modules"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "category": "Development",
      "target": "AppImage"
    },
    "artifactName": "code-akos-${version}-${os}-${arch}.${ext}"
  }
}
