{
  "name": "fixflow",
  "version": "1.0.0",
  "description": "FixFlow, the coding factory. Self-hosted error tracking, triage and automated fixes: connect a GitHub repo and a Sentry DSN, and get issues and pull requests.",
  "license": "FSL-1.1-ALv2",
  "author": "Ayesh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ayesh96/FixFlow.git"
  },
  "bugs": "https://github.com/Ayesh96/FixFlow/issues",
  "homepage": "https://github.com/Ayesh96/FixFlow#readme",
  "keywords": ["error-tracking", "sentry", "self-hosted", "triage", "github", "ollama", "deepseek"],
  "type": "module",
  "bin": {
    "fixflow": "bin/fixflow.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server/main.ts",
    "prestart": "node scripts/ensure-build.mjs",
    "dev": "node scripts/dev.mjs",
    "setup": "node scripts/setup.mjs",
    "build": "npm --prefix web run build",
    "postinstall": "npm --prefix web install",
    "typecheck": "tsc --noEmit && npm --prefix web run typecheck",
    "test": "node --test \"test/*.test.ts\" \"test/llm/*.test.ts\" \"test/projects/*.test.ts\" \"test/workflows/*.test.ts\" \"test/workflows/*/*.test.ts\" && npm --prefix web test",
    "format": "prettier --write \"server/**/*.ts\" \"test/**/*.ts\""
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
